# Copy to .env and adjust if needed.
# Start infra only: docker compose up -d postgres redis
# Full stack:     docker compose up --build

DATABASE_URL="postgresql://labcrew:labcrew@localhost:5434/labcrew?schema=public"
REDIS_URL="redis://localhost:6380"

# Auth.js (required for /app)
AUTH_SECRET="labcrew-dev-secret-change-me"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — free)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Free email — leave empty to use console + on-page reset links
# Or use free Gmail App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="LabCrew <you@gmail.com>"

# Optional LLM (Referee scoring + Coach nudge drafts)
# Without a key, heuristics are used.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
