// LabCrew — Phase 1 schema contract
// DB not required to run the Phase 1 UI (mock data).
// Wire DATABASE_URL + migrate in Phase 1b / Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  MENTOR
  STUDENT
}

enum MilestoneStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  SCORED
}

/// Professor review workflow (ClickUp-style)
enum ReviewStatus {
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  DONE
}

enum AgentName {
  DISPATCHER
  PULSE
  REFEREE
  COACH
  CLERK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  programs  Program[]
  members   Member[]
}

model Program {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  termLabel      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  members        Member[]
  milestones     Milestone[]
  agentRuns      AgentRun[]
  approvals      ApprovalItem[]
  invites        Invite[]
  files          StoredFile[]
  meetings       Meeting[]
  conversations  Conversation[]
  notifications  Notification[]
  announcements  Announcement[]
  opsSchedule    ProgramOpsSchedule?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// bcrypt hash — demo password is "labcrew" for all seeded accounts
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      Member[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  createdAt      DateTime     @default(now())
  submissions    Submission[]
  meetingInvites MeetingInvite[]
  createdMeetings Meeting[]   @relation("MeetingCreator")
  studentThreads Conversation[] @relation("StudentThread")
  sentMessages   Message[]
  notifications  Notification[]
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  announcementRecipients AnnouncementRecipient[]

  @@unique([programId, userId])
  @@index([organizationId])
}

model Milestone {
  id           String          @id @default(cuid())
  programId    String
  program      Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  /// Professor instructions shown to students
  instructions String?
  /// [{ id, title, kind: "link"|"file", url }]
  materials    Json?
  /// { requireEvidenceUrl, requireWriteup, minWriteupLength, checklist: string[] }
  rubric       Json?
  dueAt        DateTime?
  status       MilestoneStatus @default(UPCOMING)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  submissions  Submission[]
}

model Submission {
  id          String           @id @default(cuid())
  milestoneId String
  milestone   Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      SubmissionStatus @default(DRAFT)
  /// Demo URL, docs link, etc.
  evidenceUrl String?
  /// Optional GitHub repo for code deliverables
  repoUrl     String?
  writeup     String?
  checklist   Json?
  /// [{ id, title, kind, url, originalName?, size? }]
  attachments Json?
  score       Json?
  /// Professor review status (null while still draft)
  reviewStatus  ReviewStatus?
  reviewComment String?
  reviewedAt    DateTime?
  reviewedById  String?
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([milestoneId, memberId])
  @@index([memberId])
  @@index([reviewStatus])
}

model AgentRun {
  id          String         @id @default(cuid())
  programId   String
  program     Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  status      AgentRunStatus @default(QUEUED)
  trigger     String         @default("manual")
  startedAt   DateTime?
  finishedAt  DateTime?
  summary     Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       AgentStep[]
  approvals   ApprovalItem[]

  @@index([programId, createdAt])
}

model AgentStep {
  id          String          @id @default(cuid())
  runId       String
  run         AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent       AgentName
  title       String
  status      AgentStepStatus @default(PENDING)
  detail      String?
  payload     Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([runId, sortOrder])
}

model ApprovalItem {
  id          String         @id @default(cuid())
  programId   String
  program     Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  runId       String?
  run         AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind        String
  title       String
  body        String
  targetName  String?
  /// Student email when known — used for free SMTP/console delivery
  targetEmail String?
  status      ApprovalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?
  /// sent | console | failed | skipped
  deliveryStatus  String?
  /// smtp | console
  deliveryChannel String?
  deliveryError   String?
  deliveredAt     DateTime?

  @@index([programId, status])
}

model Invite {
  id          String     @id @default(cuid())
  programId   String
  program     Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole @default(STUDENT)
  token       String     @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([programId, email])
  @@index([token])
}

/// Durable free file storage in Postgres (no S3). Disk is an optional cache.
model StoredFile {
  id           String   @id @default(cuid())
  programId    String
  program      Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  filename     String   @unique
  originalName String
  contentType  String
  size         Int
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([programId])
}

enum MeetingAudience {
  ALL
  SELECTED
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

/// Director-created lab meeting (Zoom/Meet link + agenda).
model Meeting {
  id          String          @id @default(cuid())
  programId   String
  program     Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   Member          @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  agenda      String?
  meetingUrl  String?
  startsAt    DateTime
  endsAt      DateTime?
  audience    MeetingAudience @default(ALL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  invites     MeetingInvite[]

  @@index([programId, startsAt])
}

model MeetingInvite {
  id         String      @id @default(cuid())
  meetingId  String
  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  readAt     DateTime?
  rsvp       RsvpStatus?
  createdAt  DateTime    @default(now())

  @@unique([meetingId, memberId])
  @@index([memberId])
}

/// One thread per student in a program (student ↔ directors).
model Conversation {
  id              String    @id @default(cuid())
  programId       String
  program         Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  studentMemberId String
  student         Member    @relation("StudentThread", fields: [studentMemberId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  messages        Message[]

  @@unique([programId, studentMemberId])
  @@index([programId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderMemberId String
  sender         Member       @relation(fields: [senderMemberId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  /// Client optimistic id for smooth UI reconciliation
  clientId       String?

  @@index([conversationId, createdAt])
  @@index([senderMemberId])
}

model Notification {
  id        String    @id @default(cuid())
  programId String
  program   Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId, createdAt])
  @@index([memberId, readAt])
}

/// Director broadcast (deadline moves, reminders, etc.)
model Announcement {
  id          String          @id @default(cuid())
  programId   String
  program     Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   Member          @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  body        String
  audience    MeetingAudience @default(ALL)
  createdAt   DateTime        @default(now())
  recipients  AnnouncementRecipient[]

  @@index([programId, createdAt])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notifiedAt     DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([announcementId, memberId])
  @@index([memberId])
}

/// Auto weekly ops schedule (checked by worker tick).
model ProgramOpsSchedule {
  id             String    @id @default(cuid())
  programId      String    @unique
  program        Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  enabled        Boolean   @default(false)
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek      Int       @default(0)
  /// Local hour 0–23 in `timezone`
  hourLocal      Int       @default(20)
  timezone       String    @default("Asia/Karachi")
  lastEnqueuedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
