// LabCrew — multi-tenant schema
// Tenant = organizationId (labId). Every tenant-owned row carries organizationId.
// Enforcement is via repository helpers (requireLabScope / find*InLab) — never Prisma middleware.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  MENTOR
  STUDENT
}

enum MilestoneStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  SCORED
}

/// Professor review workflow (ClickUp-style)
enum ReviewStatus {
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  DONE
}

enum AgentName {
  DISPATCHER
  PULSE
  REFEREE
  COACH
  CLERK
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  programs               Program[]
  members                Member[]
  milestones             Milestone[]
  submissions            Submission[]
  submissionDataPoints   SubmissionDataPoint[]
  agentRuns              AgentRun[]
  agentSteps             AgentStep[]
  approvals              ApprovalItem[]
  invites                Invite[]
  files                  StoredFile[]
  meetings               Meeting[]
  meetingInvites         MeetingInvite[]
  conversations          Conversation[]
  messages               Message[]
  notifications          Notification[]
  announcements          Announcement[]
  announcementRecipients AnnouncementRecipient[]
  opsSchedules           ProgramOpsSchedule[]
  apiAccessTokens        ApiAccessToken[]
  engagementScores       EngagementScore[]
  submissionComments     SubmissionComment[]
  submissionReactions    SubmissionReaction[]
  submissionPosts        SubmissionPost[]
}

model Program {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  termLabel      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  members        Member[]
  milestones     Milestone[]
  agentRuns      AgentRun[]
  approvals      ApprovalItem[]
  invites        Invite[]
  files          StoredFile[]
  meetings       Meeting[]
  conversations  Conversation[]
  notifications  Notification[]
  announcements  Announcement[]
  opsSchedule    ProgramOpsSchedule?
  apiAccessTokens ApiAccessToken[]
  engagementScores EngagementScore[]

  @@index([organizationId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// bcrypt hash — demo password is "labcrew" for all seeded accounts
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      Member[]
  resetTokens  PasswordResetToken[]
  apiAccessTokens ApiAccessToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Mobile / API bearer tokens. Plain token shown once; only sha256 hash stored.
/// Scoped to a lab (organizationId) + program membership at issue time.
model ApiAccessToken {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String        @unique
  /// First 8 chars of the public token for support/revocation UX
  tokenPrefix    String
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([memberId])
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  createdAt      DateTime     @default(now())
  submissions    Submission[]
  meetingInvites MeetingInvite[]
  createdMeetings Meeting[]   @relation("MeetingCreator")
  studentThreads Conversation[] @relation("StudentThread")
  sentMessages   Message[]
  notifications  Notification[]
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  announcementRecipients AnnouncementRecipient[]
  apiAccessTokens ApiAccessToken[]
  engagementScores EngagementScore[]
  submissionComments  SubmissionComment[]
  submissionReactions SubmissionReaction[]

  @@unique([programId, userId])
  @@index([organizationId])
}

model Milestone {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  /// Professor instructions shown to students
  instructions   String?
  /// [{ id, title, kind: "link"|"file", url }]
  materials      Json?
  /// { requireEvidenceUrl, requireWriteup, minWriteupLength, checklist, acceptData?, requireData? }
  rubric         Json?
  /// Optional director-defined columns for DATA submissions:
  /// { columns: [{ name, type: "text"|"number"|"boolean" }] }
  dataSchema     Json?
  /// Approved Coach reading list (Phase C). Pending drafts live in ApprovalItem.
  /// { status: "found"|"empty", query, items: [{title,url,year,venue,source,paperId,rationale}], approvedAt }
  coachResources Json?
  dueAt          DateTime?
  status         MilestoneStatus @default(UPCOMING)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  submissions    Submission[]

  @@index([organizationId])
  @@index([programId])
}

model Submission {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestoneId    String
  milestone      Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         SubmissionStatus @default(DRAFT)
  /// Demo URL, docs link, etc.
  evidenceUrl    String?
  /// Optional GitHub repo for code deliverables
  repoUrl        String?
  writeup        String?
  checklist      Json?
  /// [{ id, title, kind, url, originalName?, size? }]
  attachments    Json?
  score          Json?
  /// Professor review status (null while still draft)
  reviewStatus   ReviewStatus?
  reviewComment  String?
  reviewedAt     DateTime?
  reviewedById   String?
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  dataPoints     SubmissionDataPoint[]
  posts          SubmissionPost[]

  @@unique([milestoneId, memberId])
  @@index([organizationId])
  @@index([memberId])
  @@index([reviewStatus])
}

/// Immutable-ish work log entry. Resubmits after review create a new post;
/// students can still edit a specific post via its edit control.
model SubmissionPost {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissionId   String
  submission     Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  /// 1-based attempt number for this student/assignment
  version        Int
  evidenceUrl    String?
  repoUrl        String?
  writeup        String?
  checklist      Json?
  attachments    Json?
  submittedAt    DateTime
  editedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  comments       SubmissionComment[]
  reactions      SubmissionReaction[]

  @@unique([submissionId, version])
  @@index([organizationId])
  @@index([submissionId, submittedAt])
}

/// Threaded feedback on a work post (social style).
model SubmissionComment {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postId           String
  post             SubmissionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorMemberId   String
  author           Member   @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  /// Null = top-level comment on the post; set = reply to another comment
  parentId         String?
  parent           SubmissionComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          SubmissionComment[] @relation("CommentReplies")
  body             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId])
  @@index([postId, createdAt])
  @@index([parentId])
}

/// Emoji reaction on a work post (one emoji type per member).
model SubmissionReaction {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postId         String
  post           SubmissionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// like | celebrate | insightful | curious
  emoji          String
  createdAt      DateTime @default(now())

  @@unique([postId, memberId, emoji])
  @@index([organizationId])
  @@index([postId])
}

enum DataValueType {
  TEXT
  NUMBER
  BOOLEAN
}

/// Generic key-value cells for structured DATA submissions (Phase A Collect).
/// One row in a CSV ≈ many SubmissionDataPoint rows sharing the same rowIndex.
model SubmissionDataPoint {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submissionId   String
  submission     Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  rowIndex       Int
  columnName     String
  /// Canonical string storage; interpret with valueType
  value          String
  valueType      DataValueType @default(TEXT)
  /// Phase B outlier / quality flag — unused in Phase A Collect
  flagged        Boolean       @default(false)
  flagReason     String?
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([submissionId, rowIndex])
  @@index([organizationId, submissionId])
}

model AgentRun {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  status         AgentRunStatus @default(QUEUED)
  trigger        String         @default("manual")
  startedAt      DateTime?
  finishedAt     DateTime?
  summary        Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  steps          AgentStep[]
  approvals      ApprovalItem[]
  engagementScores EngagementScore[]

  @@index([organizationId])
  @@index([programId, createdAt])
}

/// Per-student, per-week engagement heuristic (Adaptive Coach Phase A).
/// Directors only — never expose peer scores on student APIs.
model EngagementScore {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Monday 00:00 UTC of the ISO week this score covers
  weekStart      DateTime
  /// Heuristic 0–100
  score          Float
  /// Weighted component breakdown (timeliness, overdue, revision, meeting, messaging)
  components     Json
  computedAt     DateTime     @default(now())
  runId          String?
  run            AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([memberId, weekStart])
  @@index([organizationId])
  @@index([programId, weekStart])
  @@index([organizationId, weekStart])
}

model AgentStep {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runId          String
  run            AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent          AgentName
  title          String
  status         AgentStepStatus @default(PENDING)
  detail         String?
  payload        Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@index([runId, sortOrder])
}

model ApprovalItem {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId       String
  program         Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  runId           String?
  run             AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind            String
  title           String
  body            String
  targetName      String?
  /// Student email when known — used for free SMTP/console delivery
  targetEmail     String?
  status          ApprovalStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  decidedAt       DateTime?
  /// sent | console | failed | skipped
  deliveryStatus  String?
  /// smtp | console
  deliveryChannel String?
  deliveryError   String?
  deliveredAt     DateTime?

  @@index([organizationId])
  @@index([programId, status])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  email          String
  role           MemberRole   @default(STUDENT)
  token          String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([programId, email])
  @@index([token])
}

/// Durable free file storage in Postgres (no S3). Disk is an optional cache.
model StoredFile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  filename       String       @unique
  originalName   String
  contentType    String
  size           Int
  data           Bytes
  uploadedById   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([programId])
}

enum MeetingAudience {
  ALL
  SELECTED
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

/// Director-created lab meeting (Zoom/Meet link + agenda).
model Meeting {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      Member          @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title          String
  agenda         String?
  meetingUrl     String?
  startsAt       DateTime
  endsAt         DateTime?
  audience       MeetingAudience @default(ALL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invites        MeetingInvite[]

  @@index([organizationId])
  @@index([programId, startsAt])
}

model MeetingInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meetingId      String
  meeting        Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notifiedAt     DateTime?
  readAt         DateTime?
  rsvp           RsvpStatus?
  createdAt      DateTime     @default(now())

  @@unique([meetingId, memberId])
  @@index([organizationId])
  @@index([memberId])
}

/// One thread per student in a program (student ↔ directors).
model Conversation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId       String
  program         Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  studentMemberId String
  student         Member       @relation("StudentThread", fields: [studentMemberId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  messages        Message[]

  @@unique([programId, studentMemberId])
  @@index([organizationId])
  @@index([programId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderMemberId String
  sender         Member       @relation(fields: [senderMemberId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())
  /// Client optimistic id for smooth UI reconciliation
  clientId       String?

  @@index([organizationId])
  @@index([conversationId, createdAt])
  @@index([senderMemberId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind           String
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([memberId, createdAt])
  @@index([memberId, readAt])
}

/// Director broadcast (deadline moves, reminders, etc.)
model Announcement {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String
  program        Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      Member          @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title          String
  body           String
  audience       MeetingAudience @default(ALL)
  createdAt      DateTime        @default(now())
  recipients     AnnouncementRecipient[]

  @@index([organizationId])
  @@index([programId, createdAt])
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  notifiedAt     DateTime?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@unique([announcementId, memberId])
  @@index([organizationId])
  @@index([memberId])
}

/// Auto weekly ops schedule (checked by worker tick).
model ProgramOpsSchedule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String       @unique
  program        Program      @relation(fields: [programId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(false)
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek      Int          @default(0)
  /// Local hour 0–23 in `timezone`
  hourLocal      Int          @default(20)
  timezone       String       @default("Asia/Karachi")
  lastEnqueuedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
